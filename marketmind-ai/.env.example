# Optional backend-only market-data credential; never embed in frontend/APK.
ALPHA_VANTAGE_API_KEY=
# Replace with an identifiable contact string before SEC requests.
SEC_USER_AGENT=MarketMindAI contact@example.com
# Optional SQLite path. Default: project-root marketmind.sqlite3
# MARKETMIND_DB=./marketmind.sqlite3
# Comma-separated exact allowed frontend origins.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,capacitor://localhost,http://localhost,https://localhost
